@model CatsApp.Models.Bunny

<h1 style="text-align:center; font-family:'Times New Roman', serif; color:#6b4dff;">
🐰 Conejitos para todos 🐰
</h1>

<div style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20px; min-height:80vh;">

    <img src="@Model.url"
         style="
            max-width:90vw;
            max-height:70vh;
            object-fit:contain;
            border-radius:20px;
            box-shadow:0 10px 30px rgba(133, 105, 255, 0.3);
            border: 3px solid #a194ff;
         " />

    <button type="button" class="bunny-button" onclick="heartsAndReload()">
        🐰 ¡Nuevo conejito! 🐰
    </button>

</div>

<!-- BOTÓN LATERAL -->
<a href="/Cat" class="side-button">
    🐱 Gatitos
</a>

<style>
body{
    background-image: url('/images/Entorns fondo Bunny.png'); 
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
}

.bunny-button{
    padding:12px 24px;
    font-size:16px;
    background-color:#564dff;
    color:white;
    border:#512b9e;
    border-radius:15px;
    cursor:pointer;
    font-family:Baskerville, serif;
    font-weight:bold;
    transition:0.3s;
    box-shadow:0 5px 15px rgba(86, 77, 255, 0.3);
}

.bunny-button:hover{
    background-color:#cdb4ff;
    transform: scale(1.05);
}

/* BOTÓN LATERAL */
.side-button{
    position: fixed;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    
    background-color: rgba(86, 77, 255, 0.9);
    color: white;
    padding: 12px 18px;
    border-radius: 30px;
    text-decoration: none;
    font-family: Baskerville, serif;
    font-weight: bold;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    transition: 0.3s;
}

.side-button:hover{
    transform: translateY(-50%) scale(1.1);
    background-color: #cdb4ff;
}

@@keyframes floatUp {
    0% {
        transform: translateY(0);
        opacity: 1;
    }
    100% {
        transform: translateY(-120px);
        opacity: 0;
    }
}
</style>

<script>
function heartsAndReload() {
    for (let i = 0; i < 25; i++) {
        let heart = document.createElement("div");
        heart.innerHTML = "💖";

        heart.style.position = "fixed";
        heart.style.left = Math.random() * window.innerWidth + "px";
        heart.style.top = Math.random() * window.innerHeight + "px";
        heart.style.fontSize = (10 + Math.random() * 25) + "px";
        heart.style.pointerEvents = "none";
        heart.style.animation = "floatUp 1.5s ease-out forwards";

        document.body.appendChild(heart);

        setTimeout(() => heart.remove(), 1500);
    }

    setTimeout(() => {
        location.reload();
    }, 300);
}
</script>